<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(NexusManagedRuntime)'!='Mono'">net10.0</TargetFramework>
    <AssemblyName>Nexus.Managed.Bootstrap</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget><Configurations>Debug;Develop;Release</Configurations>
    <GenerateRuntimeConfigurationFiles Condition="'$(NexusManagedRuntime)'!='Mono'">true</GenerateRuntimeConfigurationFiles>
    <EnableDynamicLoading>true</EnableDynamicLoading><SelfContained>false</SelfContained>
    <RollForward>LatestPatch</RollForward>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Develop'">
    <DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType><Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Nexus.Managed/Nexus.Managed.csproj" /></ItemGroup>
  <ItemGroup><Compile Include="EntryPoints.cs" /><Compile Include="GameplayEntryPoints.cs" /><Compile Include="ScriptRuntime.cs" /></ItemGroup>
  <ItemGroup Condition="'$(NexusManagedRuntime)'!='Mono'"><Compile Include="GameScriptCatalog.cs" /><Compile Include="ReloadEntryPoints.cs" /></ItemGroup>
  <ItemGroup Condition="'$(NexusManagedRuntime)'=='Mono'"><Compile Include="MonoGameScriptCatalog.cs" /><Compile Include="MonoEntryPoints.cs" /></ItemGroup>
</Project>
