    <Project Path="Project/Build/NexusEditorSupport.vcxproj" />
    <Project Path="Project/Build/NexusEditor.vcxproj" />
    <Project Path="Project/Build/NexusRuntimeHost.vcxproj" />
    <Project Path="Project/Build/NexusProjectTool.vcxproj" />
  </Folder>
  <Folder Name="/Samples/">
    <Project Path="Project/Build/SampleGame.vcxproj" />
    <Project Path="Project/Build/SampleGameEditor.vcxproj" />
    <Project Path="Project/Build/SampleGameRuntime.vcxproj" />
  </Folder>
  <Folder Name="/Legacy Launcher/">
    <Project Path="Project/Build/NexusLauncher.vcxproj" />
  </Folder>
  <Folder Name="/Tests/">
