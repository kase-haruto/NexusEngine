<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework><LangVersion>latest</LangVersion><AssemblyName>GameScripts</AssemblyName>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><Configurations>Debug;Develop;Release</Configurations><PlatformTarget>x64</PlatformTarget>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><EnableDynamicLoading>true</EnableDynamicLoading>
    <NexusManagedApiPath Condition="'$(NexusManagedApiPath)'==''">$(MSBuildThisFileDirectory)Build/Bin/x64/$(Configuration)/Managed/Nexus.Managed.dll</NexusManagedApiPath>
  </PropertyGroup>
  <ItemGroup><Compile Include="@SOURCE@/Game/**/*.cs" /><Reference Include="Nexus.Managed"><HintPath>$(NexusManagedApiPath)</HintPath><Private>false</Private></Reference></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)'=='net48'"><PackageReference Include="System.Memory" Version="4.6.3" /></ItemGroup>
  <Target Name="ValidateNexusManagedApi" BeforeTargets="ResolveReferences"><Error Condition="!Exists('$(NexusManagedApiPath)')" Text="Build the Project host once to prepare Nexus.Managed, or set NexusManagedApiPath explicitly." /></Target>
</Project>
