  <PropertyGroup Condition="'$(NexusReloadFailure)'=='true'"><DefineConstants>$(DefineConstants);NEXUS_RELOAD_FAIL</DefineConstants></PropertyGroup>
  <ItemGroup><Compile Include="../ManagedGameplay/Behaviours.cs" /></ItemGroup>
  <ItemGroup><Reference Include="Nexus.Managed"><HintPath>$(NexusManagedApiPath)</HintPath><Private>false</Private></Reference></ItemGroup>
</Project>
