// Scene depthを全面的に遮蔽しても、選択輪郭のpixelが一致することを実GPUで検証する。
void SelectionOutlineIntegration() {
    Fixture test(true);
    SelectionOutline outline;
    Check(outline.Initialize(test.factory,L"Project/Shaders"));
    ConstantBuffer constants; Check(test.factory.CreateConstantBuffer(constants,sizeof(PrimitiveDrawData)));
    PrimitiveDrawData draw;
    draw.worldViewProjection=MakeScaleMatrix({.6f,.6f,1});
    const auto bytes=std::as_bytes(std::span(&draw,1));
    Check(constants.Write(0,{reinterpret_cast<const uint8_t*>(bytes.data()),bytes.size()}));
    SelectionOutlineDraw item{&test.mesh,&constants,test.mesh.GetSubmeshes().front()};
    TransientDescriptorArena transient;
    Check(transient.Initialize(test.device.GetDevice(),&test.descriptors.Resources(),2,16));
    const auto render=[&](uint32_t size,float depthValue,bool selected,size_t drawCount=1) {
        Check(test.queue.WaitForIdle());
        auto rtv=test.descriptors.RenderTargets().Allocate(); Check(rtv);
        auto dsv=test.descriptors.DepthStencils().Allocate(); Check(dsv);
        D3D12_HEAP_PROPERTIES heap{}; heap.Type=D3D12_HEAP_TYPE_DEFAULT;
        D3D12_RESOURCE_DESC desc{};
        desc.Dimension=D3D12_RESOURCE_DIMENSION_TEXTURE2D; desc.Width=size; desc.Height=size;
        desc.DepthOrArraySize=1; desc.MipLevels=1; desc.Format=DXGI_FORMAT_R16G16B16A16_FLOAT;
        desc.SampleDesc.Count=1; desc.Flags=D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
        const float background[]{.125f,.125f,.125f,1};
        D3D12_CLEAR_VALUE optimized{}; optimized.Format=desc.Format;
        std::copy(std::begin(background),std::end(background),optimized.Color);
        ComPtr<ID3D12Resource> color;
        Native(test.device.GetDevice()->CreateCommittedResource(&heap,D3D12_HEAP_FLAG_NONE,&desc,D3D12_RESOURCE_STATE_RENDER_TARGET,&optimized,IID_PPV_ARGS(&color)));
        test.device.GetDevice()->CreateRenderTargetView(color.Get(),nullptr,rtv->cpuHandle);
        auto depthDesc=desc; depthDesc.Format=DXGI_FORMAT_D32_FLOAT; depthDesc.Flags=D3D12_RESOURCE_FLAG_ALLOW_DEPTH_STENCIL;
        D3D12_CLEAR_VALUE depthClear{}; depthClear.Format=DXGI_FORMAT_D32_FLOAT; depthClear.DepthStencil.Depth=depthValue;
        ComPtr<ID3D12Resource> depth;
        Native(test.device.GetDevice()->CreateCommittedResource(&heap,D3D12_HEAP_FLAG_NONE,&depthDesc,D3D12_RESOURCE_STATE_DEPTH_WRITE,&depthClear,IID_PPV_ARGS(&depth)));
        test.device.GetDevice()->CreateDepthStencilView(depth.Get(),nullptr,dsv->cpuHandle);
        D3D12_PLACED_SUBRESOURCE_FOOTPRINT footprint{}; uint64_t total=0;
        test.device.GetDevice()->GetCopyableFootprints(&desc,0,1,0,&footprint,nullptr,nullptr,&total);
        heap.Type=D3D12_HEAP_TYPE_READBACK;
        D3D12_RESOURCE_DESC buffer{}; buffer.Dimension=D3D12_RESOURCE_DIMENSION_BUFFER; buffer.Width=total;
        buffer.Height=1; buffer.DepthOrArraySize=1; buffer.MipLevels=1; buffer.SampleDesc.Count=1; buffer.Layout=D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
        ComPtr<ID3D12Resource> readback;
        Native(test.device.GetDevice()->CreateCommittedResource(&heap,D3D12_HEAP_FLAG_NONE,&buffer,D3D12_RESOURCE_STATE_COPY_DEST,nullptr,IID_PPV_ARGS(&readback)));
        Native(test.allocator->Reset()); Native(test.commands->Reset(test.allocator.Get(),nullptr));
        transient.ResetFrame(0); test.bindless.Bind(test.commands.Get());
        auto context=GraphicsBackendTestAccess::Context(test.commands.Get(),test.bindless,0,size,size);
        GraphicsBackendTestAccess::Targets(context,rtv->cpuHandle.ptr,dsv->cpuHandle.ptr,&transient);
        context.RestoreMainRenderTargets();
        test.commands->ClearRenderTargetView(rtv->cpuHandle,background,0,nullptr);
        test.commands->ClearDepthStencilView(dsv->cpuHandle,D3D12_CLEAR_FLAG_DEPTH,depthValue,0,0,nullptr);
        const std::vector<SelectionOutlineDraw> draws(selected ? drawCount : 0,item);
        Check(outline.Render(context,draws));
        D3D12_RESOURCE_BARRIER barrier{}; barrier.Type=D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
        barrier.Transition={color.Get(),D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES,D3D12_RESOURCE_STATE_RENDER_TARGET,D3D12_RESOURCE_STATE_COPY_SOURCE};
        test.commands->ResourceBarrier(1,&barrier);
        D3D12_TEXTURE_COPY_LOCATION source{},destination{};
        source.pResource=color.Get(); source.Type=D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX;
        destination.pResource=readback.Get(); destination.Type=D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT; destination.PlacedFootprint=footprint;
        test.commands->CopyTextureRegion(&destination,0,0,0,&source,nullptr);
        Native(test.commands->Close()); test.queue.Execute(test.commands.Get()); GraphicsBackendTestAccess::Submitted(context);
        Check(test.queue.WaitForIdle());
        void* mapped=nullptr; Native(readback->Map(0,nullptr,&mapped));
        std::vector<uint16_t> pixels(static_cast<size_t>(size)*size*4);
        for(size_t y=0;y<size;++y) std::memcpy(pixels.data()+y*size*4,
            static_cast<const uint8_t*>(mapped)+footprint.Offset+y*footprint.Footprint.RowPitch,static_cast<size_t>(size)*8);
        readback->Unmap(0,nullptr);
        Check(test.descriptors.RenderTargets().Free(*rtv));
        Check(test.descriptors.DepthStencils().Free(*dsv));
        return pixels;
    };
    const auto visible=render(64,1,true), occluded=render(64,0,true), noSelection=render(64,0,false);
    Require(visible==occluded,"Scene depth changed the selection outline.");
    Require(render(64,1,true,300)==visible,"Selection with more than 256 draws changed the outline.");
    size_t orange=0;
    for(size_t i=0;i<visible.size();i+=4) if(visible[i]>visible[i+1] && visible[i+1]>visible[i+2]) ++orange;
    Require(orange>80,"Selection outline was not rendered.");
    const size_t center=(32*64+32)*4;
    Require(std::equal(visible.begin()+center,visible.begin()+center+4,noSelection.begin()+center),"Selection mask filled the object interior.");
    Require(visible!=noSelection,"Empty selection did not remove the outline.");
    render(96,0,true); Require(render(64,0,true)==visible,"Resize or previous mask contents changed the outline.");
    draw.worldViewProjection=MakeScaleMatrix({-.6f,.6f,1});
    Check(constants.Write(0,{reinterpret_cast<const uint8_t*>(bytes.data()),bytes.size()}));
    Require(render(64,0,true)==visible,"Mirrored geometry lost its outline.");
    outline.Shutdown(); Check(test.queue.WaitForIdle()); test.bindless.CollectGarbage(UINT64_MAX);
    transient.Shutdown(); test.Validate();
    std::cout << "PASS: depth-independent selection outline, empty/interior mask, resize, mirrored geometry and GPU validation\n";
}
