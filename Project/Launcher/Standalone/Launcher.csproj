<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>NexusLauncher</AssemblyName>
    <Version>1.3.0</Version>
    <Configurations>Debug;Develop;Release</Configurations>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Develop'">
    <DebugSymbols>true</DebugSymbols><DebugType>portable</DebugType><Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="../../Templates/**/*" Exclude="../../Templates/Samples/**/*;../../Templates/Behaviour/**/*" Link="Templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Previewと初期LevelはTemplate資源として独立配布し、既存SDKのinventoryを変更しない。 -->
    <Content Include="../../Resources/Editor/Icons/project.png" Link="PreviewAssets/project.png"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="launcher.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Remove-Launcher.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="Launcher.Development.targets" />
</Project>
